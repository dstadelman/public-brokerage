# Public Brokerage API Configuration

# Required: Your Public Personal Secret Token
# Get this from your Public account settings page
PUBLIC_SECRET_TOKEN=your_secret_token_here

# Optional: Default validity for access tokens in minutes (default: 15)
ACCESS_TOKEN_VALIDITY_MINUTES=15

# Optional: Base URL for the API (default: https://public.com)
PUBLIC_API_BASE_URL=https://api.public.com

# Optional: Request timeout in seconds (default: 30)
REQUEST_TIMEOUT=30

# Optional: Maximum number of retry attempts (default: 3)
MAX_RETRIES=3

# Optional: Enable debug logging (default: False)
DEBUG_LOGGING=False
